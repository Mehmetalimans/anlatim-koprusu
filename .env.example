# Bu dosyayı .env adıyla kopyalayın ve değeri YALNIZCA .env içine yazın.
# .env repoya eklenmez (.gitignore). Anahtarı sohbete, videoya veya başka dosyaya yazmayın.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# zero_shot veya few_shot (MA-03 prompt karşılaştırması için)
PROMPT_VERSION=few_shot
